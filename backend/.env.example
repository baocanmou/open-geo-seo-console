APP_ENV=production
APP_URL=https://geo.example.com
APP_KEY=base64:replace-with-32-random-bytes
APP_TIMEZONE=UTC
DB_TIMEZONE=+00:00
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=open_geo
DB_USER=open_geo_app
DB_PASSWORD=replace-on-server-only
SESSION_SECURE=true
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800
SESSION_ROTATE_INTERVAL=900
AUDIT_MAX_SECONDS=50
AUDIT_MAX_REQUESTS=64
AUDIT_MAX_TOTAL_BYTES=16777216
AUDIT_FAILURE_BACKOFF_HOURS=6
